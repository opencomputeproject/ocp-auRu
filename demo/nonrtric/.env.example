# NONRTRIC image tags for the `full` profile (upstream docker-compose/.env on master, tested together).
# No secrets here. The compose file inlines the same defaults, so this file is optional.
ICS_IMAGE_BASE=nexus3.o-ran-sc.org:10002/o-ran-sc/nonrtric-information-coordinator-service
ICS_IMAGE_TAG=1.2.1
CATALOGUE_IMAGE_BASE=nexus3.o-ran-sc.org:10002/o-ran-sc/nonrtric-r-app-catalogue
CATALOGUE_IMAGE_TAG=1.0.2
PMS_IMAGE_BASE=nexus3.o-ran-sc.org:10002/o-ran-sc/nonrtric-a1-policy-management-service
PMS_IMAGE_TAG=2.3.1
A1SIM_IMAGE_BASE=nexus3.o-ran-sc.org:10002/o-ran-sc/a1-simulator
A1SIM_IMAGE_TAG=2.2.0

# Host ports (container ports are the upstream defaults: 8083, 8680, 8081, 8085).
ICS_HOST_PORT=18083
CATALOGUE_HOST_PORT=18680
PMS_HOST_PORT=18081
A1SIM_HOST_PORT=18085

# Host interface the ports above are published on. Loopback by default (no auth on ICS/catalogue);
# widen deliberately, e.g. BIND_IP=0.0.0.0, only on a firewalled host.
BIND_IP=127.0.0.1
